# ============================================================
# Showroom configuration. Copy to `.env` and fill in.
# `.env` is git-ignored; never commit a value from it.
# ============================================================

# --- Versions the showroom pins -----------------------------
# The published core image. Bumping it is a pull request here, and the reset's
# own verification is what catches a breaking change.
SOWEL_IMAGE=ghcr.io/mchacher/sowel:1.68.0
# The simulator release whose demo fixture the reset restores.
SIMULATOR_VERSION=0.2.0

# --- Where the demo answers ---------------------------------
# The proxy's port on the host. Sowel's own port is deliberately NOT published:
# the only way in is the proxy, which is what makes the deny list mean anything.
PROXY_PORT=8080
# What the landing page and the proxy call themselves. In production this is the
# public name the tunnel terminates (phase 5); locally, leave it.
PUBLIC_ORIGIN=http://localhost:8080

# --- The admin the reset creates ----------------------------
# Never exposed to a visitor. Used only by `reset.sh`, over the compose network.
ADMIN_USERNAME=showroom-admin
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME="Showroom Admin"

# --- The guest every visitor is -----------------------------
# This password reaches every browser: the landing page logs in with it so a
# visitor types nothing. That is deliberate (spec 001, FR2) — what a guest can do
# is safe by construction, and the deny list is what makes it so. Choose something
# memorable rather than something secret — and put it in `.env`, not here: the
# reset hands it to the landing page at runtime (`landing/showroom/config.json`,
# git-ignored), so no credential is ever committed even though this one is public.
GUEST_USERNAME=visiteur
GUEST_PASSWORD=
GUEST_DISPLAY_NAME=Visiteur

# --- The home the demo simulates ----------------------------
# The simulator reads these three (core spec 111 lets a plugin read them) and
# derives the sun from them. Paris by default, matching the fixture.
HOME_LATITUDE=48.8566
HOME_LONGITUDE=2.3522
HOME_TIMEZONE=Europe/Paris

# --- Optional: packages the instance cannot fetch itself ----
# Leave both empty for the normal path: a fresh instance downloads whatever the
# fixture registers and it is missing (core spec 058). Two situations need a hand —
# the registry does not carry the plugin yet, or the host cannot reach GitHub (a
# corporate proxy intercepting TLS is enough, and phase 1 hit exactly that).
#
# SIMULATOR_TARBALL: a path to sowel-plugin-simulator-<version>.tar.gz
# PACKAGES_DIR:      a directory of already-extracted packages, one per subdirectory
SIMULATOR_TARBALL=
PACKAGES_DIR=

# --- The 3D house ------------------------------------------
# The static build of sowel-house-3d, served at /maison on this origin so it shares
# the landing page's session. A sibling checkout by default; build it with
# `npm run build` in that repository.
HOUSE_3D_DIST=../sowel-house-3d/dist

# --- InfluxDB ----------------------------------------------
# The reset keeps this volume: history accrues from launch day, by decision.
INFLUX_TOKEN=
INFLUX_ORG=sowel
INFLUX_BUCKET=sowel
INFLUX_USERNAME=sowel
INFLUX_PASSWORD=
