{
  "name": "sowel-showroom",
  "version": "0.0.0",
  "description": "Infrastructure for the public Sowel demo",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write \"**/*.{md,yml,yaml,json}\"",
    "format:check": "prettier --check \"**/*.{md,yml,yaml,json}\"",
    "lint:sh": "bash scripts/check-shell.sh",
    "lint:compose": "bash scripts/check-compose.sh",
    "validate": "npm run format:check && npm run lint:sh && npm run lint:compose && npm run lint:env && npm run lint:deny && npm run lint:proxy && bash scripts/check-specs-complete.sh && bash scripts/check-specs-index.sh",
    "prepare": "husky",
    "lint:proxy": "bash scripts/check-proxy.sh",
    "lint:deny": "bash scripts/check-deny-list.sh",
    "lint:env": "bash scripts/check-env-example.sh"
  },
  "lint-staged": {
    "*.{md,yml,yaml,json}": [
      "prettier --write"
    ],
    "scripts/*.sh": [
      "bash scripts/check-shell.sh"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6"
  },
  "license": "AGPL-3.0"
}
